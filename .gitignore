# dependencies
/node_modules
/.pnp
.pnp.js

# next.js build output
/.next/
/out/
/build

# testing
/coverage

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files - never commit credentials or DATABASE_URL
.env
.env.*
!.env.example

# misc
.DS_Store
*.pem
.vercel
.netlify

# typescript / next generated
*.tsbuildinfo
next-env.d.ts

# NOTE: package-lock.json is deliberately NOT ignored.
# It is committed so Netlify installs the exact dependency versions
# that were tested locally, instead of resolving ^ ranges at build time.
